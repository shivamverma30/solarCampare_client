// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPERADMIN
  ADMIN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeadStatus {
  NEW
  CONTACTED
  VENDOR_ASSIGNED
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum NotificationAudience {
  ADMIN
  USER
  VENDOR
}

enum NotificationType {
  SYSTEM
  USER_SIGNUP
  VENDOR_SIGNUP
  LEAD_CREATED
  LEAD_UPDATED
  VENDOR_APPROVED
  VENDOR_REJECTED
  INQUIRY
  QUOTE_REQUEST
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum UploadPurpose {
  VENDOR_DOCUMENT
  USER_DOCUMENT
  LEAD_ATTACHMENT
  QUOTE_ATTACHMENT
  PROFILE_IMAGE
  OTHER
}

enum UploadProvider {
  LOCAL
  CLOUDINARY
  S3
}

enum QuoteRequestStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
  ARCHIVED
}

enum AuditEntityType {
  ADMIN
  USER
  VENDOR
  PRODUCT
  LEAD
  INQUIRY
  CALCULATOR
}

model Admin {
  id        String     @id @default(cuid())
  email     String     @unique
  singletonKey String  @unique @default("SOLE_ADMIN")
  password  String
  name      String
  avatarUrl String?
  role      AdminRole  @default(SUPERADMIN)
  status    AccountStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  products  Product[]
  assignedVendorLeads VendorLead[] @relation("LeadAssignedAdmin")
  vendorApprovals Vendor[] @relation("VendorApprovedBy")
  vendorRejections Vendor[] @relation("VendorRejectedBy")
  leadStatusLogs LeadStatusLog[]
  vendorStatusLogs VendorStatusLog[]
  commissionNotes CommissionNote[] @relation("CommissionNotesCreatedBy")
  internalNotes AdminInternalNote[] @relation("InternalNotesCreatedBy")
  auditLogs AuditLog[] @relation("AuditCreatedBy")
  notifications Notification[]
  notificationReceipts NotificationReadState[]
  uploads UploadAsset[] @relation("UploadsCreatedByAdmin")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("admins")
}

model Product {
  id          String     @id @default(cuid())
  title       String
  brand       String
  type        String
  efficiency  Float
  warranty    Int        // in years
  wattage     Int        // in watts
  description String
  image       String?
  adminId     String?
  vendorId    String?
  admin       Admin?     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  vendor      Vendor?    @relation("VendorProducts", fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([adminId])
  @@index([vendorId])
  @@map("products")
}

model User {
  id               String              @id @default(cuid())
  fullName         String
  email            String              @unique
  phone            String?
  pincode          String?
  avatarUrl        String?
  password         String
  city             String?
  state            String?
  status           AccountStatus       @default(ACTIVE)
  emailVerifiedAt  DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  calculatorHistory CalculatorHistory[]
  contactInquiries  ContactInquiry[]
  vendorLeads       VendorLead[]
  notifications     Notification[]
  notificationReceipts NotificationReadState[]
  quoteRequests     QuoteRequest[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  uploads           UploadAsset[]

  @@map("users")
}

model Vendor {
  id               String              @id @default(cuid())
  companyName      String
  ownerName        String
  email            String              @unique
  phone            String
  gst              String?
  serviceArea      String
  address          String
  city             String?
  state            String?
  pincode          String?
  logoUrl          String?
  avatarUrl        String?
  businessType     String
  experience       Int
  services         String[]            @default([])
  password         String
  status           VendorStatus        @default(PENDING)
  emailVerifiedAt  DateTime?
  rejectionReason  String?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  approvedByAdminId String?
  rejectedByAdminId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  documents        VendorDocument[]
  statusLogs       VendorStatusLog[]
  leads            VendorLead[]
  commissionNotes  CommissionNote[]
  notifications    Notification[]
  notificationReceipts NotificationReadState[]
  serviceAreas     VendorServiceArea[]
  quoteRequests    QuoteRequest[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  uploads          UploadAsset[]
  products         Product[]           @relation("VendorProducts")
  approvedByAdmin  Admin?              @relation("VendorApprovedBy", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  rejectedByAdmin  Admin?              @relation("VendorRejectedBy", fields: [rejectedByAdminId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([serviceArea])
  @@map("vendors")
}

model VendorDocument {
  id          String   @id @default(cuid())
  vendorId    String
  documentName String
  fileUrl     String
  fileType    String
  isVerified  Boolean  @default(false)
  uploadAssetId String? @unique
  createdAt   DateTime @default(now())
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  uploadAsset UploadAsset? @relation(fields: [uploadAssetId], references: [id], onDelete: SetNull)

  @@index([vendorId])
  @@index([uploadAssetId])
  @@map("vendor_documents")
}

model VendorServiceArea {
  id           String   @id @default(cuid())
  vendorId     String
  pincode      String
  city         String?
  state        String?
  district     String?
  isPrimary    Boolean  @default(false)
  coverageRank Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  vendor       Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([pincode])
  @@index([city])
  @@index([state])
  @@map("vendor_service_areas")
}

model VendorStatusLog {
  id             String       @id @default(cuid())
  vendorId       String
  previousStatus VendorStatus
  newStatus      VendorStatus
  note           String?
  actorAdminId   String?
  createdAt      DateTime     @default(now())
  vendor         Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  actorAdmin     Admin?       @relation(fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@index([vendorId])
  @@index([newStatus])
  @@map("vendor_status_logs")
}

model ContactInquiry {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  subject    String?
  message    String
  source     String   @default("website")
  userId     String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([createdAt])
  @@map("contact_inquiries")
}

model VendorLead {
  id                 String            @id @default(cuid())
  userId             String?
  vendorId           String
  userName           String
  userEmail          String
  userPhone          String?
  serviceRequirement String
  location           String
  notes              String?
  status             LeadStatus        @default(NEW)
  assignedAdminId    String?
  commissionEstimate Float?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  vendor             Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  assignedAdmin      Admin?            @relation("LeadAssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  statusLogs         LeadStatusLog[]
  commissionNotes    CommissionNote[]

  @@index([vendorId])
  @@index([userEmail])
  @@index([status])
  @@map("vendor_leads")
}

model LeadStatusLog {
  id            String      @id @default(cuid())
  leadId        String
  previousStatus LeadStatus
  newStatus     LeadStatus
  note          String?
  actorAdminId  String?
  createdAt     DateTime    @default(now())
  lead          VendorLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actorAdmin    Admin?      @relation(fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([newStatus])
  @@map("lead_status_logs")
}

model CommissionNote {
  id               String      @id @default(cuid())
  leadId           String
  vendorId         String?
  note             String
  amount           Float?
  createdByAdminId String?
  createdAt        DateTime    @default(now())
  lead             VendorLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  vendor           Vendor?     @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  createdByAdmin   Admin?      @relation("CommissionNotesCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@map("commission_notes")
}

model AdminInternalNote {
  id               String      @id @default(cuid())
  entityType       String
  entityId         String
  note             String
  createdByAdminId String?
  createdAt        DateTime    @default(now())
  createdByAdmin   Admin?      @relation("InternalNotesCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@map("admin_internal_notes")
}

model Notification {
  id          String                @id @default(cuid())
  audience    NotificationAudience
  type        NotificationType
  title       String
  body        String
  metadata    Json?
  adminId     String?
  userId      String?
  vendorId    String?
  readAt      DateTime?
  createdAt   DateTime              @default(now())
  admin       Admin?                @relation(fields: [adminId], references: [id], onDelete: SetNull)
  user        User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  vendor      Vendor?               @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  readStates  NotificationReadState[]

  @@index([audience])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationReadState {
  id             String   @id @default(cuid())
  notificationId String
  adminId        String?
  userId         String?
  vendorId       String?
  readAt         DateTime?
  createdAt      DateTime @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  admin          Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  vendor         Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([notificationId])
  @@index([adminId])
  @@index([userId])
  @@index([vendorId])
  @@map("notification_read_states")
}

model EmailVerificationToken {
  id          String              @id @default(cuid())
  purpose     VerificationPurpose  @default(EMAIL_VERIFICATION)
  token       String              @unique
  email       String
  userId      String?
  vendorId    String?
  adminId     String?
  otpHash     String?
  payload     Json?
  attempts    Int                 @default(0)
  resendCount Int                 @default(0)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime            @default(now())
  user        User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor      Vendor?             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  admin       Admin?              @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
  @@index([purpose])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id          String   @id @default(cuid())
  token       String   @unique
  email       String
  userId      String?
  vendorId    String?
  adminId     String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor      Vendor?  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  admin       Admin?   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model QuoteRequest {
  id          String             @id @default(cuid())
  userId      String?
  vendorId    String?
  fullName    String
  email       String
  phone       String?
  pincode     String?
  city        String?
  state       String?
  projectType String?
  monthlyBill Int?
  roofSize    Int?
  notes       String?
  status      QuoteRequestStatus @default(NEW)
  metadata    Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  vendor      Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  uploads     UploadAsset[]

  @@index([userId])
  @@index([vendorId])
  @@index([pincode])
  @@index([status])
  @@map("quote_requests")
}

model UploadAsset {
  id              String         @id @default(cuid())
  ownerType       String
  ownerId         String?
  purpose         UploadPurpose  @default(OTHER)
  provider        UploadProvider @default(LOCAL)
  userId          String?
  vendorId        String?
  publicId        String?
  url             String
  secureUrl       String?
  originalName    String?
  mimeType        String?
  sizeInBytes     Int?
  width           Int?
  height          Int?
  checksum        String?
  metadata        Json?
  createdByAdminId String?
  quoteRequestId  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdByAdmin  Admin?         @relation("UploadsCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  vendor          Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  quoteRequest    QuoteRequest?   @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  vendorDocument  VendorDocument?

  @@index([ownerType, ownerId])
  @@index([userId])
  @@index([vendorId])
  @@index([quoteRequestId])
  @@index([purpose])
  @@index([provider])
  @@map("upload_assets")
}

model AuditLog {
  id          String          @id @default(cuid())
  actorType   String
  actorId     String?
  action      String
  entityType  AuditEntityType
  entityId    String?
  metadata    Json?
  createdByAdminId String?
  createdAt   DateTime        @default(now())
  createdByAdmin Admin?       @relation("AuditCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model CalculatorHistory {
  id              String   @id @default(cuid())
  userId          String?
  calculatorType  String
  inputs          Json
  outputs         Json
  createdAt       DateTime @default(now())
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([calculatorType])
  @@index([createdAt])
  @@map("calculator_history")
}
