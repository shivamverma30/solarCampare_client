# ========================
# ROOT .gitignore (SOLAR)
# Applies to frontend + backend
# ========================

# Dependencies
**/node_modules/
**/.pnp
**/.pnp.js

# Build folders
**/.next/
**/dist/
**/build/
**/out/
**/.turbo/

# Environment files
**/.env
**/.env.*
**/.env.local
**/.env.development.local
**/.env.production.local
**/.env.test.local

# Logs
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Cache
**/.cache/
**/.parcel-cache/

# Vercel / Deploy
**/.vercel/

# TypeScript
**/*.tsbuildinfo
**/next-env.d.ts

# OS files
**/.DS_Store
**/Thumbs.db

# IDE
**/.vscode/
**/.idea/

# Python / misc
**/__pycache__/
**/*.pyc

# Markdown Docs
**/*.md

# Specific Docs
**/AGENTS.md
**/CLAUDE.md
**/README.md

# Temporary files
**/*.tmp
**/*.temp
**/*.log